---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Sidebar from "@/components/Sidebar.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import MomentFeed from "@/components/MomentFeed.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getFeedItems } from "@/utils/getFeedItems";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

// 首页动态流:手写动态 + 自动同步的文章动态
// 精选文章上面已经展示过了,这里不重复出现
const feedItems = await getFeedItems();
const homeFeedItems = feedItems
  .filter(item => !(item.kind === "post" && item.post?.data.featured))
  .slice(0, config.moments.perIndex);
---

<Layout>
  <Header />
  <div class="flex flex-1">
    <Sidebar />
    <main
      id="main-content"
      data-layout="index"
      data-home-path={homePath}
      class="app-layout my-1 min-w-0 flex-1"
    >
      <section id="hero" class="border-border border-b pt-8 pb-6">
        <blockquote class="my-4 sm:my-8">
          <p
            class="text-muted-foreground text-xl font-light italic sm:text-2xl"
          >
            "The only way to do great work is to love what you do."
          </p>
          <cite class="text-accent mt-4 block text-base not-italic">
            — Steve Jobs
          </cite>
        </blockquote>
        {
          socials.length > 0 && (
            <div class="mt-4 flex max-sm:flex-col sm:items-center">
              <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                {t.home.socialLinks}:
              </div>
              <Socials />
            </div>
          )
        }
      </section>

      {
        featuredPosts.length > 0 && (
          <section id="featured" class="border-border border-b pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">
              {t.home.featured}
            </h2>
            <ul>
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
        )
      }

      <section id="moments" class="pt-12 pb-6">
        <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.moments}
          </h2>
          <a
            href={getRelativeLocaleUrl(locale, "moments")}
            class="text-accent text-sm hover:underline"
          >
            {t.home.allMoments} →
          </a>
        </div>
        <MomentFeed items={homeFeedItems} />
      </section>

      <div class="my-8 flex flex-wrap justify-center gap-3">
        <LinkButton href={getRelativeLocaleUrl(locale, "moments")}>
          {t.home.allMoments}
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
        <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
          {t.home.allPosts}
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </div>
    </main>
  </div>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
